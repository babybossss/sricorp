# SRI OS — ตัวอย่างค่า env (คัดลอกเป็น .env.local แล้วใส่ค่าจริง · ห้าม commit .env.local)
#
# ใช้เฉพาะ publishable key (ชื่อเดิมคือ anon key) เท่านั้น
# ห้ามใส่ secret / service-role key ที่ใดเลย — มันข้าม RLS ทั้งหมด ซึ่งเท่ากับเห็นเงินทุกคนในบ้าน
# โค้ดจะปฏิเสธคีย์ชนิดนั้นเองถ้าเผลอใส่
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ใช้กับสคริปต์ `npm run check:permissions` เท่านั้น (ไม่ใช่ตัวแอป) — connection string ของ DB
# ที่อยากเทียบสิทธิ์ · เว้นว่างได้ ถ้าจะใช้โหมด --migrations
# SRI_DB_URL=postgresql://...
